# ═════════════════════════════════════════════════════
# LLM 配置 — 至少填一个
# ═════════════════════════════════════════════════════

# 兼容旧变量（兜底 provider 使用）
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 各 provider 独立 Key（LLMRouter 按任务路由）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=      # 通义千问（Qwen）
MINIMAX_API_KEY=

# ═════════════════════════════════════════════════════
# 数据源
# ═════════════════════════════════════════════════════

# Tushare 期货/兜底行情（可选，无 token 时自动禁用）
TUSHARE_TOKEN=

# AKShare 限频（秒/请求）
AKSHARE_REQUEST_INTERVAL=1.0

# ═════════════════════════════════════════════════════
# 数据库 & 管理后台
# ═════════════════════════════════════════════════════

DB_PATH=./data/stock_advisor.db
ADMIN_PORT=8900
ADMIN_PASSWORD=changeme

# 分享链接的公网 base URL（部署时填服务器域名）
# 未填时使用 http://localhost:8900
PUBLIC_BASE_URL=

# ═════════════════════════════════════════════════════
# 对话历史
# ═════════════════════════════════════════════════════

CHAT_HISTORY_ROUNDS=5
MEMORY_LOAD_LIMIT=20
